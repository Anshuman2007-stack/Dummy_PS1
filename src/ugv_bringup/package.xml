<?xml version="1.0"?>
<package format="3">
  <name>ugv_bringup</name>
  <version>0.2.0</version>
  <description>Top-level launch files that start the whole UGV simulation + navigation stack</description>
  <maintainer email="you@example.com">anshu</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>my_bot_sim</exec_depend>
  <exec_depend>ugv_sensors</exec_depend>
  <exec_depend>ugv_control</exec_depend>
  <exec_depend>ugv_nav</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>

  <export><build_type>ament_cmake</build_type></export>
</package>

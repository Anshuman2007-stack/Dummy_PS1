<?xml version="1.0"?>
<sdf version="1.8">
  <world name="my_world">
    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <plugin filename="ignition-gazebo-physics-system" name="ignition::gazebo::systems::Physics"/>
    <plugin filename="ignition-gazebo-user-commands-system" name="ignition::gazebo::systems::UserCommands"/>
    <plugin filename="ignition-gazebo-scene-broadcaster-system" name="ignition::gazebo::systems::SceneBroadcaster"/>
    <plugin filename="ignition-gazebo-sensors-system" name="ignition::gazebo::systems::Sensors"/>
    <plugin filename="ignition-gazebo-imu-system" name="ignition::gazebo::systems::Imu"/>

    <!-- GPS datum. heading_deg 0 => world +X = East, +Y = North (ENU).
         ugv_sensors/gps_node and the EKF use the same datum (datum_lat/lon params). -->
    <spherical_coordinates>
      <surface_model>EARTH_WGS84</surface_model>
      <latitude_deg>22.62</latitude_deg>
      <longitude_deg>75.69</longitude_deg>
      <elevation>0</elevation>
      <heading_deg>0</heading_deg>
    </spherical_coordinates>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.9 0.9 0.9 1</diffuse>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal><size>200 200</size></plane></geometry>
        </collision>
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>200 200</size></plane></geometry>
          <material><ambient>0.6 0.6 0.6 1</ambient><diffuse>0.6 0.6 0.6 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- target pad G1 at (4, 0) - visual only, the robot can drive over it -->
    <model name="target_g1">
      <static>true</static>
      <pose>4 0 0.002 0 0 0</pose>
      <link name="link">
        <visual name="pad">
          <geometry><cylinder><radius>0.25</radius><length>0.004</length></cylinder></geometry>
          <material><ambient>0.92 0.41 0.20 1</ambient><diffuse>0.92 0.41 0.20 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- target pad G2 at (0, 4) - visual only, the robot can drive over it -->
    <model name="target_g2">
      <static>true</static>
      <pose>0 4 0.002 0 0 0</pose>
      <link name="link">
        <visual name="pad">
          <geometry><cylinder><radius>0.25</radius><length>0.004</length></cylinder></geometry>
          <material><ambient>0.11 0.69 0.48 1</ambient><diffuse>0.11 0.69 0.48 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- target pad G3 at (-3, -3) - visual only, the robot can drive over it -->
    <model name="target_g3">
      <static>true</static>
      <pose>-3 -3 0.002 0 0 0</pose>
      <link name="link">
        <visual name="pad">
          <geometry><cylinder><radius>0.25</radius><length>0.004</length></cylinder></geometry>
          <material><ambient>0.38 0.31 0.84 1</ambient><diffuse>0.38 0.31 0.84 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- target pad G4 at (5, -2) - visual only, the robot can drive over it -->
    <model name="target_g4">
      <static>true</static>
      <pose>5 -2 0.002 0 0 0</pose>
      <link name="link">
        <visual name="pad">
          <geometry><cylinder><radius>0.25</radius><length>0.004</length></cylinder></geometry>
          <material><ambient>0.91 0.48 0.64 1</ambient><diffuse>0.91 0.48 0.64 1</diffuse></material>
        </visual>
      </link>
    </model>
  </world>
</sdf>

<?xml version="1.0"?>
<!--
  my_bot: four-wheel differential-drive (skid-steer) UGV for Gazebo Fortress.

  Frames (identical to urdf/my_bot.urdf, which robot_state_publisher uses for TF):
    base_link   model origin on the ground, x forward, y left, z up
    wheels      (+-0.15, +-0.20, 0.10), radius 0.10 m  -> wheelbase 0.30 m, track 0.40 m
    imu         (0, 0, 0.15) in base_link

  Drive: there is NO DiffDrive plugin. Each wheel joint gets a torque from the
  ApplyJointForce plugin (topic /model/my_bot/joint/<joint>/cmd_force), computed
  by our own PID (ugv_control) + motor model (motor_driver_sim). The joint
  <damping> of 0.5 N m s/rad is the DC motor back-EMF (stall 5 N m / no-load 10 rad/s).

  Encoders: JointStatePublisher publishes all wheel joint angles/velocities;
  ugv_sensors/wheel_odometry_node quantises the angles into encoder ticks.
-->
<sdf version="1.8">
  <model name="my_bot">

    <!-- ================= Chassis (base_link is on the ground) ================= -->
    <link name="base_link">
      <pose>0 0 0 0 0 0</pose>
      <inertial>
        <pose>0 0 0.12 0 0 0</pose>
        <mass>5.0</mass>
        <inertia>
          <ixx>0.047</ixx><iyy>0.114</iyy><izz>0.142</izz>
          <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz>
        </inertia>
      </inertial>
      <collision name="chassis_collision">
        <pose>0 0 0.12 0 0 0</pose>
        <geometry><box><size>0.5 0.3 0.1</size></box></geometry>
      </collision>
      <visual name="chassis_visual">
        <pose>0 0 0.12 0 0 0</pose>
        <geometry><box><size>0.5 0.3 0.1</size></box></geometry>
        <material><ambient>0.1 0.3 0.8 1</ambient><diffuse>0.1 0.3 0.8 1</diffuse></material>
      </visual>
      <visual name="front_marker">
        <pose>0.22 0 0.175 0 0 0</pose>
        <geometry><box><size>0.04 0.2 0.01</size></box></geometry>
        <material><ambient>0.9 0.9 0.9 1</ambient><diffuse>0.9 0.9 0.9 1</diffuse></material>
      </visual>

      <!-- IMU: gyro + accelerometer noise; orientation is published noise-free by
           Gazebo, which is why the EKF does not use it by default. -->
      <sensor name="imu_sensor" type="imu">
        <pose>0 0 0.15 0 0 0</pose>
        <always_on>1</always_on>
        <update_rate>100</update_rate>
        <topic>imu</topic>
        <imu>
          <angular_velocity>
            <x><noise type="gaussian"><mean>0</mean><stddev>0.002</stddev></noise></x>
            <y><noise type="gaussian"><mean>0</mean><stddev>0.002</stddev></noise></y>
            <z><noise type="gaussian"><mean>0</mean><stddev>0.002</stddev></noise></z>
          </angular_velocity>
          <linear_acceleration>
            <x><noise type="gaussian"><mean>0</mean><stddev>0.02</stddev></noise></x>
            <y><noise type="gaussian"><mean>0</mean><stddev>0.02</stddev></noise></y>
            <z><noise type="gaussian"><mean>0</mean><stddev>0.02</stddev></noise></z>
          </linear_acceleration>
        </imu>
      </sensor>
    </link>

    <!-- ================= Wheels =================
         Each wheel link is rolled -90 deg about x so its z axis (the joint axis)
         points to +y (left). Positive joint velocity then rolls the robot forward
         on BOTH sides. Collision is a sphere: one clean contact point per wheel,
         which DART handles more robustly than cylinder-plane contacts. -->
    <link name="front_left_wheel">
      <pose>0.15 0.2 0.1 -1.5707963 0 0</pose>
      <inertial>
        <mass>0.5</mass>
        <inertia><ixx>0.0030</ixx><iyy>0.0030</iyy><izz>0.0050</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia>
      </inertial>
      <collision name="collision">
        <geometry><sphere><radius>0.1</radius></sphere></geometry>
        <surface><friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction></surface>
      </collision>
      <visual name="visual">
        <geometry><cylinder><radius>0.1</radius><length>0.05</length></cylinder></geometry>
        <material><ambient>0.1 0.1 0.1 1</ambient><diffuse>0.1 0.1 0.1 1</diffuse></material>
      </visual>
    </link>

    <link name="rear_left_wheel">
      <pose>-0.15 0.2 0.1 -1.5707963 0 0</pose>
      <inertial>
        <mass>0.5</mass>
        <inertia><ixx>0.0030</ixx><iyy>0.0030</iyy><izz>0.0050</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia>
      </inertial>
      <collision name="collision">
        <geometry><sphere><radius>0.1</radius></sphere></geometry>
        <surface><friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction></surface>
      </collision>
      <visual name="visual">
        <geometry><cylinder><radius>0.1</radius><length>0.05</length></cylinder></geometry>
        <material><ambient>0.1 0.1 0.1 1</ambient><diffuse>0.1 0.1 0.1 1</diffuse></material>
      </visual>
    </link>

    <link name="front_right_wheel">
      <pose>0.15 -0.2 0.1 -1.5707963 0 0</pose>
      <inertial>
        <mass>0.5</mass>
        <inertia><ixx>0.0030</ixx><iyy>0.0030</iyy><izz>0.0050</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia>
      </inertial>
      <collision name="collision">
        <geometry><sphere><radius>0.1</radius></sphere></geometry>
        <surface><friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction></surface>
      </collision>
      <visual name="visual">
        <geometry><cylinder><radius>0.1</radius><length>0.05</length></cylinder></geometry>
        <material><ambient>0.1 0.1 0.1 1</ambient><diffuse>0.1 0.1 0.1 1</diffuse></material>
      </visual>
    </link>

    <link name="rear_right_wheel">
      <pose>-0.15 -0.2 0.1 -1.5707963 0 0</pose>
      <inertial>
        <mass>0.5</mass>
        <inertia><ixx>0.0030</ixx><iyy>0.0030</iyy><izz>0.0050</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia>
      </inertial>
      <collision name="collision">
        <geometry><sphere><radius>0.1</radius></sphere></geometry>
        <surface><friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction></surface>
      </collision>
      <visual name="visual">
        <geometry><cylinder><radius>0.1</radius><length>0.05</length></cylinder></geometry>
        <material><ambient>0.1 0.1 0.1 1</ambient><diffuse>0.1 0.1 0.1 1</diffuse></material>
      </visual>
    </link>

    <!-- ================= Wheel joints (damping = motor back-EMF) ================= -->
    <joint name="front_left_wheel_joint" type="revolute">
      <parent>base_link</parent><child>front_left_wheel</child>
      <axis><xyz>0 0 1</xyz>
        <limit><lower>-1e16</lower><upper>1e16</upper><effort>20</effort></limit>
        <dynamics><damping>0.5</damping><friction>0.0</friction></dynamics>
      </axis>
    </joint>
    <joint name="rear_left_wheel_joint" type="revolute">
      <parent>base_link</parent><child>rear_left_wheel</child>
      <axis><xyz>0 0 1</xyz>
        <limit><lower>-1e16</lower><upper>1e16</upper><effort>20</effort></limit>
        <dynamics><damping>0.5</damping><friction>0.0</friction></dynamics>
      </axis>
    </joint>
    <joint name="front_right_wheel_joint" type="revolute">
      <parent>base_link</parent><child>front_right_wheel</child>
      <axis><xyz>0 0 1</xyz>
        <limit><lower>-1e16</lower><upper>1e16</upper><effort>20</effort></limit>
        <dynamics><damping>0.5</damping><friction>0.0</friction></dynamics>
      </axis>
    </joint>
    <joint name="rear_right_wheel_joint" type="revolute">
      <parent>base_link</parent><child>rear_right_wheel</child>
      <axis><xyz>0 0 1</xyz>
        <limit><lower>-1e16</lower><upper>1e16</upper><effort>20</effort></limit>
        <dynamics><damping>0.5</damping><friction>0.0</friction></dynamics>
      </axis>
    </joint>

    <!-- ================= Actuators: one torque input per wheel ================= -->
    <plugin filename="ignition-gazebo-apply-joint-force-system"
            name="ignition::gazebo::systems::ApplyJointForce">
      <joint_name>front_left_wheel_joint</joint_name>
    </plugin>
    <plugin filename="ignition-gazebo-apply-joint-force-system"
            name="ignition::gazebo::systems::ApplyJointForce">
      <joint_name>rear_left_wheel_joint</joint_name>
    </plugin>
    <plugin filename="ignition-gazebo-apply-joint-force-system"
            name="ignition::gazebo::systems::ApplyJointForce">
      <joint_name>front_right_wheel_joint</joint_name>
    </plugin>
    <plugin filename="ignition-gazebo-apply-joint-force-system"
            name="ignition::gazebo::systems::ApplyJointForce">
      <joint_name>rear_right_wheel_joint</joint_name>
    </plugin>

    <!-- ================= Encoders: wheel joint angles + velocities ================= -->
    <plugin filename="ignition-gazebo-joint-state-publisher-system"
            name="ignition::gazebo::systems::JointStatePublisher">
      <joint_name>front_left_wheel_joint</joint_name>
      <joint_name>rear_left_wheel_joint</joint_name>
      <joint_name>front_right_wheel_joint</joint_name>
      <joint_name>rear_right_wheel_joint</joint_name>
    </plugin>

    <!-- ================= Ground truth (evaluation + GPS source) ================= -->
    <plugin filename="ignition-gazebo-odometry-publisher-system"
            name="ignition::gazebo::systems::OdometryPublisher">
      <odom_frame>world</odom_frame>
      <robot_base_frame>base_link_true</robot_base_frame>
      <odom_topic>true_odom</odom_topic>
      <odom_publish_frequency>50</odom_publish_frequency>
      <dimensions>2</dimensions>
    </plugin>

  </model>
</sdf>

<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>ugv_core</name>
  <version>0.2.0</version>
  <description>ROS-independent UGV algorithms (EKF, skid-steer kinematics, PID, encoder odometry, navigation law) and the shared robot parameters</description>
  <maintainer email="you@example.com">anshu</maintainer>
  <license>MIT</license>

  <exec_depend>python3-numpy</exec_depend>

  <test_depend>python3-pytest</test_depend>
  <test_depend>ament_flake8</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>

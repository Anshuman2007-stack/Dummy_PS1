<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>ugv_control</name>
  <version>0.2.0</version>
  <description>Stages 4-5: (v, omega) to four wheel speeds, per-wheel velocity PID with anti-windup producing PWM duty</description>
  <maintainer email="you@example.com">anshu</maintainer>
  <license>MIT</license>

  <depend>rclpy</depend>
  <depend>geometry_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>std_msgs</depend>
  <exec_depend>ugv_core</exec_depend>
  <exec_depend>ugv_sensors</exec_depend>
  <exec_depend>my_bot_sim</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>

  <test_depend>ament_flake8</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
